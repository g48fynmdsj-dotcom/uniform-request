<!DOCTYPE html>
<html lang="ar" dir="rtl">

<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>السلة - نظام طلب الزي الرسمي</title>

<style>

body {
margin: 0;
font-family: Arial, sans-serif;
background: #f4f7fb;
color: #12345b;
}

.header {
background: #123f70;
color: white;
padding: 25px;
text-align: center;
}

.container {
max-width: 900px;
margin: 30px auto;
padding: 20px;
}

.back {
display: inline-block;
margin-bottom: 20px;
color: #123f70;
text-decoration: none;
font-weight: bold;
}

.cart-box {
background: white;
padding: 25px;
border-radius: 18px;
box-shadow: 0 3px 15px #d8e0ea;
}

.item {
display: flex;
justify-content: space-between;
align-items: center;
padding: 18px 5px;
border-bottom: 1px solid #e5ebf2;
gap: 15px;
}

.item-info {
font-size: 17px;
line-height: 1.8;
}

.delete {
background: #b3261e;
color: white;
border: none;
padding: 10px 18px;
border-radius: 8px;
cursor: pointer;
}

.empty {
text-align: center;
padding: 40px;
font-size: 18px;
color: #777;
}

.total {
font-size: 20px;
font-weight: bold;
margin-top: 25px;
text-align: center;
}

.confirm {
display: block;
margin: 25px auto 0;
background: #123f70;
color: white;
border: none;
padding: 15px 40px;
border-radius: 10px;
font-size: 17px;
cursor: pointer;
}

.confirm:hover {
background: #0d3159;
}

</style>
</head>


<body>

<div class="header">

<h1>🛒 السلة</h1>

<p>مراجعة طلب الزي الرسمي</p>

</div>


<div class="container">

<a href="index.html" class="back">
← العودة للرئيسية
</a>


<div class="cart-box">

<div id="cartItems"></div>

<div class="total" id="total"></div>

<button class="confirm" onclick="confirmOrder()">
تأكيد وإرسال الطلب
</button>

</div>

</div>


<script>


function loadCart() {

let cart =
JSON.parse(localStorage.getItem("uniformCart")) || [];

let container =
document.getElementById("cartItems");

let total =
document.getElementById("total");


if (cart.length === 0) {

container.innerHTML =
'<div class="empty">السلة فارغة حالياً 🛒</div>';

total.innerHTML = "";

return;

}


container.innerHTML = "";


cart.forEach((item, index) => {

let div =
document.createElement("div");

div.className = "item";


div.innerHTML = `

<div class="item-info">

<strong>
${item.name || "قطعة زي رسمي"}
</strong>

${item.size ?
"<br>المقاس: " + item.size : ""}

${item.employeeName ?
"<br>الاسم: " + item.employeeName : ""}

</div>


<button
class="delete"
onclick="removeItem(${index})">

حذف

</button>

`;


container.appendChild(div);

});


total.innerHTML =
"عدد القطع: " + cart.length;

}



function removeItem(index) {

let cart =
JSON.parse(localStorage.getItem("uniformCart")) || [];


cart.splice(index, 1);


localStorage.setItem(
"uniformCart",
JSON.stringify(cart)
);


loadCart();

}



function confirmOrder() {

let cart =
JSON.parse(localStorage.getItem("uniformCart")) || [];


if (cart.length === 0) {

alert("السلة فارغة");

return;

}


// إنشاء رقم الطلب

let now = new Date();


let date =
now.getFullYear().toString() +

(now.getMonth() + 1)
.toString()
.padStart(2, "0") +

now.getDate()
.toString()
.padStart(2, "0");


let random =
Math.floor(1000 + Math.random() * 9000);


let orderNumber =
"UR-" + date + "-" + random;



// حفظ الطلب

let orders =
JSON.parse(
localStorage.getItem("uniformOrders")
) || [];


let newOrder = {

number: orderNumber,

date:
new Date().toLocaleString("ar-AE"),

status: "جديد",

items: cart

};


orders.push(newOrder);


localStorage.setItem(
"uniformOrders",
JSON.stringify(orders)
);



// إفراغ السلة

localStorage.removeItem(
"uniformCart"
);



// رسالة النجاح

alert(

"تم إرسال الطلب بنجاح ✅\n\n" +

"رقم الطلب: " +

orderNumber

);



// العودة للرئيسية

window.location.href =
"index.html";

}



loadCart();

</script>

</body>

</html>
